{
  "server": "http://192.168.1.X:8085",
  "allowed_servers": [
    "http://192.168.1.X:8085"
  ],
  "rom_source": {
    "mode": "share",
    "share_root": "Z:\\",
    "cache_dir": "C:\\romm\\cache"
  },
  "platforms": {
    "wii": {
      "action": "emulator",
      "command": "{emulator_path}",
      "args": "-b -e \"{rom_path}\"",
      "extract_zip": true,
      "rom_extensions": [".wbfs", ".rvz", ".iso", ".wia", ".gcz", ".ciso"]
    }
  }
}